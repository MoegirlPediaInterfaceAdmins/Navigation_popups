{
    "name": "navigation-popups",
    "repository": {
        "type": "git",
        "url": "https://github.com/MoegirlPediaInterfaceAdmins/Navigation_popups.git"
    },
    "type": "module",
    "private": true,
    "engines": {
        "node": "^24.11"
    },
    "scripts": {
        "build": "node scripts/build.js",
        "build:css": "node scripts/build-css.js",
        "ci": "npm ci",
        "test": "npm run build && npm run build:css && npm run test:eslint && npm run test:stylelint && npm run test:tsc && npm run test:unit && npm run test:terser && npm run test:idempotent && npm run test:css && npm run test:postcss && npm run test:mailmap",
        "test:eslint": "eslint . --max-warnings 0",
        "test:stylelint": "stylelint \"dist/**/*.css\" --color --max-warnings 0",
        "test:tsc": "tsc -p tsconfig.json",
        "test:unit": "vitest run --coverage",
        "test:terser": "node scripts/terser-check.js",
        "test:idempotent": "node scripts/build.js --check-idempotent",
        "test:css": "node scripts/build-css.js --check-idempotent",
        "test:postcss": "node scripts/postcss/index.js",
        "test:mailmap": "node scripts/emailmapChecker/index.js",
        "lint:commit-message": "node scripts/commitLint/index.js commits",
        "lint:pr-title": "node scripts/commitLint/index.js title",
        "format:eslint": "npm run test:eslint -- --fix",
        "format:stylelint": "npm run test:stylelint -- --fix",
        "prepare": "node .husky/install.mjs"
    },
    "dependencies": {
        "@annangela/eslint-config": "^15.0.0",
        "eslint": "^10.11.0",
        "terser": "^5.51.2",
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@actions/core": "^3.0.1",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.2",
        "@commitlint/lint": "^21.2.2",
        "@commitlint/load": "^21.2.2",
        "@csstools/postcss-is-pseudo-class": "^6.0.0",
        "@csstools/postcss-media-minmax": "^3.0.4",
        "@octokit/auth-action": "^6.0.3",
        "@octokit/auth-unauthenticated": "^7.0.5",
        "@octokit/plugin-retry": "^8.1.1",
        "@octokit/rest": "^22.0.1",
        "@types/jquery": "^4.0.1",
        "@vitest/coverage-istanbul": "^5.0.1",
        "@vitest/coverage-v8": "^5.0.1",
        "acorn": "^8.18.0",
        "autoprefixer": "^10.6.0",
        "husky": "^9.1.7",
        "jquery": "^4.0.0",
        "jsdom": "^30.1.0",
        "moment": "^2.31.0",
        "postcss": "^8.5.28",
        "postcss-discard-comments": "^9.0.3",
        "postcss-font-variant": "^5.0.0",
        "postcss-load-config": "^6.0.1",
        "postcss-logical": "^9.0.0",
        "postcss-selector-not": "^9.0.0",
        "rollup": "^4.63.4",
        "rollup-plugin-esbuild": "^6.2.1",
        "sass": "^1.104.1",
        "simple-git": "^3.36.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-plugin-use-baseline": "^1.4.6",
        "types-mediawiki": "^2.1.0",
        "vitest": "^5.0.1",
        "yaml": "^2.9.1"
    }
}
