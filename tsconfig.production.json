{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "dist/_compiled",
        "rootDir": "dist",
        "types": [],
        "allowImportingTsExtensions": false,
        // exactOptionalPropertyTypes must be explicitly false here: it is
        // inherited as true from tsconfig.json, and enabling it under
        // strictNullChecks: false is a config-level error (TS5052).
    },
    "include": [
        "dist/Gadget-popups.js"
    ]
}
