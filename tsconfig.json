{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        // One program for both gates:
        //  - src/**: strict type checking (checkJs is off, these are .ts)
        //  - dist/**: syntax gate for the bundled artifact (allowJs + checkJs off)
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "target": "es2022",
        "lib": [
            "ESNext",
            "DOM",
        ],
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "types": [
            "jquery",
        ],
        "allowUmdGlobalAccess": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "newLine": "lf",
    },
    "include": [
        "src",
        "node_modules/moment/moment.d.ts",
        "node_modules/types-mediawiki",
        "dist",
    ],
}
